model_name_or_path: __CFLLM_BASE_MODEL__

stage: sft
do_train: true
finetuning_type: lora
lora_target: all

dataset: py25,cpp25
dataset_dir: __CFLLM_DATASET_DIR__
template: qwen
cutoff_len: 4096
max_samples: 1000
overwrite_cache: true
preprocessing_num_workers: 16

output_dir: __CFLLM_RQ2_OUTPUT__
logging_steps: 10
save_steps: 500
plot_loss: true
overwrite_output_dir: true

per_device_train_batch_size: 1
gradient_accumulation_steps: 8
learning_rate: 1.0e-4
num_train_epochs: 5.0
lr_scheduler_type: cosine
warmup_ratio: 0.1
bf16: true

val_size: 0.1
per_device_eval_batch_size: 1
eval_strategy: steps
eval_steps: 500
