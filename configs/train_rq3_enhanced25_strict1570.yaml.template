model_name_or_path: __CFLLM_BASE_MODEL__
adapter_name_or_path: __CFLLM_RQ2_ADAPTER__

stage: sft
do_train: true
finetuning_type: lora
lora_target: all

dataset: rq3_enhanced25_strict1570
dataset_dir: __CFLLM_DATASET_DIR__
template: qwen
cutoff_len: 1024
overwrite_cache: true
preprocessing_num_workers: 16

output_dir: __CFLLM_RQ3_OUTPUT__
logging_steps: 10
save_steps: 500
plot_loss: true
overwrite_output_dir: true

per_device_train_batch_size: 1
gradient_accumulation_steps: 8
learning_rate: 5.0e-6
warmup_steps: 20
num_train_epochs: 1.0
lr_scheduler_type: cosine
bf16: true

val_size: 0.1
per_device_eval_batch_size: 1
eval_strategy: steps
eval_steps: 500
